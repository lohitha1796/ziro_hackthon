# Security Questionnaire Filler - .gitignore
# Never commit secrets or local-only state.

# Environment files (may contain real API keys)
.env
.env.local
.env.*.local
.env.production.local

# Dependency / build output (not used by this zero-install app, but kept safe)
node_modules/
package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.dist/
build/
dist/
out/
.next/
.vercel/

# OS-generated files
.DS_Store
Thumbs.db
desktop.ini

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log

# Browser profile / temporary
*.tmp
*.temp
