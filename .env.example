# Security Questionnaire Filler - environment variables
# Copy this file to .env.local and fill in values for local development.
# Never commit .env.local or any file containing real secrets.

# LLM provider (optional - the deterministic engine works offline without this)
# Set to "openai-compatible" to enable the LLM adapter; otherwise "deterministic"
SQF_LLM_MODE=deterministic

# Base URL for an OpenAI-compatible chat-completions endpoint (optional)
SQF_LLM_BASE_URL=https://api.openai.com/v1

# Model name (optional)
SQF_LLM_MODEL=gpt-4o-mini

# API key for the LLM provider (optional - never committed to git)
# This is only needed if SQF_LLM_MODE=openai-compatible.
# The demo runs fully without it.
SQF_LLM_API_KEY=

# Transport mode: "mock" (default, offline) or "http" (real fetch)
SQF_TRANSPORT=mock

# Application URL (for deployed builds)
SQF_APP_URL=http://localhost:8777
